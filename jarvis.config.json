{
  "network": {
    "enabled": false,
    "allowlist": [],
    "allowlistDomains": [],
    "allowlistUrls": []
  },
  "telemetry": {
    "enabled": false
  },
  "killSwitch": {
    "enabled": true
  },
  "governance": {
    "strictApprovalMode": true,
    "networkApprovalMode": "per_request",
    "maxNetworkPayloadBytes": 16384
  },
  "audit": {
    "logPath": "logs/audit.log",
    "redactKeys": [
      "password",
      "secret",
      "token",
      "api_key",
      "apikey",
      "authorization"
    ]
  },
  "permissions": {
    "writeAllowlist": ["workspace", "data"],
    "readAllowlist": ["data", "workspace", "docs"]
  }
}
