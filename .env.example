# Example only — do not put real secrets here
# Generate secure tokens using: node scripts/generate-tokens.js

# ===== CORE AUTHENTICATION =====
# Owner authentication token (required) - generate with scripts/generate-tokens.js
SAFA_OWNER_TOKEN=

# Owner PIN for additional security (optional, default: 1234)
SAFA_PIN=1234

# Session signing key for secure sessions (required for production)
SESSION_SIGNING_KEY=

# HMAC key for worker authentication (required for relay/workers)
WORKER_HMAC_KEY=

# ===== NETWORK CONFIGURATION =====
# Enable live network access (0=disabled, 1=enabled)
SAFA_NETWORK_LIVE=0

# ===== LLM CONFIGURATION =====
# OpenAI API key (required for LLM features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API key (optional, for Claude models)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# LLM Router configuration
ROUTER_DEFAULT_MODE=auto
ROUTER_DEFAULT_MODEL=openai:gpt-4o-mini

# ===== EMAIL CONFIGURATION (SMTP) =====
# SMTP server settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP authentication credentials
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# From address for outgoing emails
EMAIL_FROM="Your Name <your_gmail@gmail.com>"

# Alternative Email Providers:
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587

# ===== PAYMENTS (STRIPE) =====
# Stripe API keys (get from https://dashboard.stripe.com/apikeys)
# Use test keys (sk_test_...) for development
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ===== PHONE/SMS (TWILIO) =====
# Twilio credentials (get from https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== VERSION CONTROL (GITHUB) =====
# GitHub personal access token (optional, for Git operations)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# ===== VERCEL KV (RELAY) =====
# Vercel KV credentials for relay functionality
# Get from: https://vercel.com/dashboard/stores
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
